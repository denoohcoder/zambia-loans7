{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": "server",
      "framework": "express"
    },
    "server-2": {
      "root": "zambia-loans7-main/server",
      "framework": "express"
    }
  },
  "rewrites": [
